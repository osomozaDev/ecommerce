# ── Storefront Engine ────────────────────────────────────────────────
# Copia este archivo a .env.local y ajusta los valores.

# Fuente de datos: "fixtures" (sin credenciales, ideal para UI) o "shopify" (tienda real)
COMMERCE_DATA_SOURCE=fixtures

# Tenant activo en este despliegue (ids registrados en src/config/tenants/)
TENANT_ID=default

# ── Secretos (SOLO server-side; nunca usar prefijo NEXT_PUBLIC_) ─────
# Token de la Storefront API (app "Headless" o custom app de la tienda Shopify).
# Necesario únicamente con COMMERCE_DATA_SOURCE=shopify.
SHOPIFY_STOREFRONT_TOKEN=

# Versión de la Storefront API (opcional; por defecto 2025-10)
# SHOPIFY_API_VERSION=2025-10

# Secreto de firma de webhooks (admin Shopify → Settings → Notifications → Webhooks,
# aparece al pie de la página). Necesario para la invalidación de caché en tiempo real.
SHOPIFY_WEBHOOK_SECRET=

# ── Multi-tenant (fase 2) ─────────────────────────────────────────────
# Con varias tiendas en un mismo deploy, los secretos van POR TENANT con
# sufijo (id en mayúsculas, guiones → guiones bajos). El valor sin sufijo
# actúa como fallback.
# SHOPIFY_STOREFRONT_TOKEN__TIENDA_B=
# SHOPIFY_WEBHOOK_SECRET__TIENDA_B=
#
# La resolución de tenant es por dominio (Host). TENANT_ID solo es el
# fallback para hosts no registrados y contextos sin request.

# ── Config externa de tenants (fase 3, opcional) ──────────────────────
# URL de un JSON (array de tenants) que se mezcla sobre los del repo:
# editar una tienda deja de requerir deploy. Revalidación: 300 s o
# POST /api/revalidate con el bearer REVALIDATE_SECRET.
# TENANTS_URL=
# REVALIDATE_SECRET=

# ── Generación de tiendas por IA (scripts/genera-tienda.mjs) ──────────
# Clave de la API de Anthropic (o autentícate con `ant auth login`).
# Solo se usa al ejecutar el generador; la app no la necesita.
# ANTHROPIC_API_KEY=
